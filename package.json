{
  "name": "@sleeperhq/react-restorable",
  "version": "0.1.0",
  "description": "State that survives its tree being unmounted: a component's useState and a list's scroll position come back when the screen that held them is rebuilt.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blitzstudios/react-restorable.git"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "./lib/module/index",
  "module": "./lib/module/index",
  "types": "./lib/typescript/module/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./react-navigation": {
      "import": {
        "types": "./lib/typescript/module/react-navigation/index.d.ts",
        "default": "./lib/module/react-navigation/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/react-navigation/index.d.ts",
        "default": "./lib/commonjs/react-navigation/index.js"
      }
    },
    "./react-native": {
      "import": {
        "types": "./lib/typescript/module/react-native/index.d.ts",
        "default": "./lib/module/react-native/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/react-native/index.d.ts",
        "default": "./lib/commonjs/react-native/index.js"
      }
    },
    "./babel": {
      "types": "./lib/typescript/commonjs/babel/index.d.ts",
      "default": "./lib/commonjs/babel/index.js"
    },
    "./testing": {
      "import": {
        "types": "./lib/typescript/module/testing/index.d.ts",
        "default": "./lib/module/testing/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/testing/index.d.ts",
        "default": "./lib/commonjs/testing/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "react-navigation/package.json",
    "react-native/package.json",
    "babel/package.json",
    "testing/package.json",
    "!**/tests",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "scripts": {
    "build": "yarn typecheck && bob build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:prod": "jest --config jest.config.prod.js",
    "test:all": "yarn test && yarn test:prod",
    "prepublishOnly": "yarn build"
  },
  "peerDependencies": {
    "@babel/core": ">=7",
    "@react-navigation/core": ">=6",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    },
    "@react-navigation/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-typescript": "^7.24.7",
    "@react-navigation/core": "7.13.7",
    "@types/babel__core": "^7.20.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.14",
    "@types/react-test-renderer": "19.1.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native-builder-bob": "^0.31.0",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "**/{tests/**,*.test.ts,*.test.tsx}",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "esm": true
        }
      ]
    ]
  },
  "packageManager": "yarn@4.14.1"
}
